{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with account metadata and membership details.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier matching Firebase Auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL",
          "maxLength": 500
        },
        "phoneNumber": {
          "type": "string",
          "description": "User contact telephone or mobile number",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        }
      },
      "required": [
        "id",
        "email",
        "createdAt"
      ]
    },
    "AiSummary": {
      "title": "AiSummary",
      "description": "Saved AI Astrological synthesis report for a native chart.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the summary record",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "nativeName": {
          "type": "string",
          "description": "Name of the native whose Kundli was summarized",
          "maxLength": 100
        },
        "lagnaSign": {
          "type": "string",
          "description": "Lagna ascendant sign name",
          "maxLength": 50
        },
        "summaryData": {
          "type": "object",
          "description": "Structured astrological synthesis data payload"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when summary was generated"
        }
      },
      "required": [
        "id",
        "userId",
        "nativeName",
        "summaryData",
        "createdAt"
      ]
    },
    "MatchSubmission": {
      "title": "MatchSubmission",
      "description": "Vedic Kundli Match Finder calculation record stored for 24 hours with automatic expiration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the match record",
          "maxLength": 128
        },
        "partner1": {
          "type": "object",
          "description": "Partner 1 details including name, gender, dob, tob with AM/PM, and place of birth"
        },
        "partner2": {
          "type": "object",
          "description": "Partner 2 details including name, gender, dob, tob with AM/PM, and place of birth"
        },
        "ashtakootaScore": {
          "type": "number",
          "description": "Calculated Vedic Guna Milan score out of 36"
        },
        "maximumScore": {
          "type": "number",
          "description": "Maximum achievable Guna score (36)"
        },
        "compatibilityVerdict": {
          "type": "string",
          "description": "Overall compatibility recommendation",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiration timestamp exactly 24 hours after creation for automated TTL deletion"
        },
        "sessionId": {
          "type": "string",
          "description": "Client session identifier for querying recent match records",
          "maxLength": 128
        }
      },
      "required": [
        "partner1",
        "partner2",
        "createdAt",
        "expiresAt"
      ]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Bookmarked store product saved to the user's wishlist for later purchase.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique item identifier, matches product id as string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "productId": {
          "type": "number",
          "description": "Numeric product ID"
        },
        "productSlug": {
          "type": "string",
          "description": "Product URL slug",
          "maxLength": 150
        },
        "name": {
          "type": "string",
          "description": "Product title",
          "maxLength": 200
        },
        "price": {
          "type": "number",
          "description": "Current item price"
        },
        "salePrice": {
          "type": "number",
          "description": "Optional discounted sale price"
        },
        "imageUrl": {
          "type": "string",
          "description": "Primary product image URL",
          "maxLength": 500
        },
        "categoryName": {
          "type": "string",
          "description": "Product category name",
          "maxLength": 100
        },
        "inStock": {
          "type": "boolean",
          "description": "Stock availability flag"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added to wishlist"
        }
      },
      "required": [
        "id",
        "userId",
        "productId",
        "productSlug",
        "name",
        "price",
        "createdAt"
      ]
    },
    "UserOrder": {
      "title": "UserOrder",
      "description": "User purchase order record with tracking status and item line details.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order record identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "orderNumber": {
          "type": "string",
          "description": "Human-readable order number (e.g. ASTRO-2026-4892)",
          "maxLength": 64
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order amount paid"
        },
        "orderStatus": {
          "type": "string",
          "description": "Current fulfillment status",
          "maxLength": 50
        },
        "itemCount": {
          "type": "number",
          "description": "Total quantity of items in order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Order placement timestamp"
        }
      },
      "required": [
        "id",
        "userId",
        "orderNumber",
        "totalAmount",
        "orderStatus",
        "createdAt"
      ]
    },
    "DailyHoroscope": {
      "title": "DailyHoroscope",
      "description": "Calculated and interpreted daily Vedic horoscope record for a user on a given date.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Date of horoscope in YYYY-MM-DD format",
          "maxLength": 10
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "description": "Calendar date string YYYY-MM-DD",
          "maxLength": 10
        },
        "overallScore": {
          "type": "number",
          "description": "Overall cosmic alignment score from 0 to 100"
        },
        "summary": {
          "type": "string",
          "description": "Executive astrological summary for the day",
          "maxLength": 1000
        },
        "strongestPlanet": {
          "type": "string",
          "description": "Strongest benefic or activating planet today",
          "maxLength": 50
        },
        "biggestOpportunity": {
          "type": "string",
          "description": "Highest scoring domain and favorable transit opportunity",
          "maxLength": 200
        },
        "biggestChallenge": {
          "type": "string",
          "description": "Most sensitive domain requiring mindfulness and remedy",
          "maxLength": 200
        },
        "dailyAdvice": {
          "type": "string",
          "description": "Practical and actionable daily Jyotish guidance",
          "maxLength": 500
        },
        "mantra": {
          "type": "string",
          "description": "Recommended daily Vedic chant or Beej mantra",
          "maxLength": 200
        },
        "luckyNumber": {
          "type": "number",
          "description": "Numerologically calculated auspicious number for the day"
        },
        "luckyColor": {
          "type": "string",
          "description": "Auspicious planetary color for the day",
          "maxLength": 50
        },
        "luckyDirection": {
          "type": "string",
          "description": "Auspicious directional alignment (Digbala)",
          "maxLength": 50
        },
        "luckyTime": {
          "type": "string",
          "description": "Auspicious Choghadiya or Shubh Hora window",
          "maxLength": 100
        },
        "confidenceScore": {
          "type": "number",
          "description": "Astrological confidence rating percentage (0-100)"
        },
        "scores": {
          "type": "object",
          "description": "Scores across 20 distinct life categories"
        },
        "categoryDetails": {
          "type": "object",
          "description": "Detailed category explanations with astrological drivers and advice"
        },
        "astrologicalHighlights": {
          "type": "object",
          "description": "Transits, Vimshottari dasha rulers, and Panchang parameters"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Generation timestamp"
        }
      },
      "required": [
        "id",
        "userId",
        "date",
        "overallScore",
        "summary",
        "createdAt"
      ]
    },
    "HoroscopeFeedback": {
      "title": "HoroscopeFeedback",
      "description": "User accuracy rating and feedback for a daily horoscope prediction.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique feedback ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User UID submitting feedback",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "description": "Horoscope date evaluated",
          "maxLength": 10
        },
        "rating": {
          "type": "number",
          "description": "Accuracy rating from 1 to 4 stars"
        },
        "accuracyVerdict": {
          "type": "string",
          "description": "Label matching rating (Very Accurate, Accurate, Partly Accurate, Not Accurate)",
          "maxLength": 50
        },
        "comment": {
          "type": "string",
          "description": "Optional user reflections or observations",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Feedback timestamp"
        }
      },
      "required": [
        "id",
        "userId",
        "date",
        "rating",
        "createdAt"
      ]
    },
    "HoroscopeSubscription": {
      "title": "HoroscopeSubscription",
      "description": "Daily horoscope delivery schedule and notification channel preferences.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Subscription identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Subscriber user UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Delivery email address",
          "maxLength": 150
        },
        "phoneNumber": {
          "type": "string",
          "description": "Optional telephone or WhatsApp number",
          "maxLength": 30
        },
        "preferredTime": {
          "type": "string",
          "description": "Preferred delivery time in HH:mm format",
          "maxLength": 10
        },
        "channels": {
          "type": "array",
          "description": "Enabled notification channels",
          "items": { "type": "string" }
        },
        "active": {
          "type": "boolean",
          "description": "Subscription status flag"
        },
        "consentGiven": {
          "type": "boolean",
          "description": "Explicit user consent flag for receiving daily updates"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Subscription timestamp"
        }
      },
      "required": [
        "id",
        "userId",
        "email",
        "preferredTime",
        "channels",
        "active",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/matchSubmissions/{matchId}": {
      "schema": "MatchSubmission",
      "description": "Temporary 24-hour collection of partner matching submissions with automated TTL policy."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document owned by the authenticated user."
    },
    "/users/{userId}/aiSummaries/{summaryId}": {
      "schema": "AiSummary",
      "description": "Collection of saved AI astrological summaries belonging to the user."
    },
    "/users/{userId}/dailyHoroscopes/{date}": {
      "schema": "DailyHoroscope",
      "description": "User daily horoscope archive collection partitioned by calendar date."
    },
    "/users/{userId}/horoscopeFeedback/{feedbackId}": {
      "schema": "HoroscopeFeedback",
      "description": "User accuracy feedback records on daily horoscope predictions."
    },
    "/users/{userId}/horoscopeSubscriptions/{subId}": {
      "schema": "HoroscopeSubscription",
      "description": "Daily horoscope delivery channel configuration."
    },
    "/users/{userId}/wishlist/{itemId}": {
      "schema": "WishlistItem",
      "description": "Collection of bookmarked store items saved by the user for later purchase."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "UserOrder",
      "description": "User purchase orders mirror collection for real-time tracking."
    }
  }
}
