rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPartner(p) {
      return p is map &&
        p.keys().hasAll(['name', 'gender', 'dob', 'tob', 'hour', 'minute', 'period', 'city', 'latitude', 'longitude', 'timezoneOffset']) &&
        p.name is string && p.name.size() <= 100 &&
        p.gender is string && (p.gender == 'male' || p.gender == 'female' || p.gender == 'other') &&
        p.dob is string && p.dob.size() == 10 &&
        p.tob is string && p.tob.size() <= 10 &&
        p.hour is string && p.hour.size() <= 5 &&
        p.minute is string && p.minute.size() <= 5 &&
        p.period is string && (p.period == 'AM' || p.period == 'PM') &&
        p.city is string && p.city.size() <= 150 &&
        p.latitude is number && p.latitude >= -90.0 && p.latitude <= 90.0 &&
        p.longitude is number && p.longitude >= -180.0 && p.longitude <= 180.0 &&
        p.timezoneOffset is number && p.timezoneOffset >= -14.0 && p.timezoneOffset <= 14.0;
    }

    function isValidMatchSubmission(data) {
      return data.keys().hasAll(['id', 'partner1', 'partner2', 'ashtakootaScore', 'maximumScore', 'compatibilityVerdict', 'createdAt', 'expiresAt', 'sessionId']) &&
        data.keys().size() == 9 &&
        data.id is string && isValidId(data.id) &&
        isValidPartner(data.partner1) &&
        isValidPartner(data.partner2) &&
        data.ashtakootaScore is number && data.ashtakootaScore >= 0 && data.ashtakootaScore <= 36 &&
        data.maximumScore is number && data.maximumScore == 36 &&
        data.compatibilityVerdict is string && data.compatibilityVerdict.size() <= 200 &&
        data.createdAt == request.time &&
        data.expiresAt is timestamp &&
        data.expiresAt > request.time &&
        data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(5, 'm') &&
        data.sessionId is string && data.sessionId.size() <= 128;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.id is string && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 150 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
        (!('dob' in data) || (data.dob is string && data.dob.size() == 10)) &&
        (!('tob' in data) || (data.tob is string && data.tob.size() <= 10)) &&
        (!('isTobUnknown' in data) || data.isTobUnknown is bool) &&
        (!('birthPlace' in data) || (data.birthPlace is string && data.birthPlace.size() <= 150)) &&
        (!('latitude' in data) || (data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0)) &&
        (!('longitude' in data) || (data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0)) &&
        (!('timezoneOffset' in data) || (data.timezoneOffset is number && data.timezoneOffset >= -14.0 && data.timezoneOffset <= 14.0)) &&
        (!('gender' in data) || (data.gender is string && (data.gender == 'male' || data.gender == 'female' || data.gender == 'other'))) &&
        (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 20)) &&
        (!('notificationTime' in data) || (data.notificationTime is string && data.notificationTime.size() <= 10)) &&
        (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
        (!('notificationChannels' in data) || (data.notificationChannels is list && data.notificationChannels.size() <= 5)) &&
        (!('consentGiven' in data) || data.consentGiven is bool) &&
        (!('consentTimestamp' in data) || (data.consentTimestamp is string && data.consentTimestamp.size() <= 50)) &&
        data.createdAt is timestamp;
    }

    function isValidDailyHoroscope(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'date', 'overallScore', 'summary', 'createdAt']) &&
        data.id is string && data.id.size() == 10 &&
        data.userId is string && data.userId == userId &&
        data.date is string && data.date.size() == 10 &&
        data.overallScore is number && data.overallScore >= 0 && data.overallScore <= 100 &&
        data.summary is string && data.summary.size() <= 2000 &&
        (!('scores' in data) || data.scores is map) &&
        (!('categoryDetails' in data) || data.categoryDetails is map) &&
        (!('astrologicalHighlights' in data) || data.astrologicalHighlights is map) &&
        (!('confidenceScore' in data) || (data.confidenceScore is number && data.confidenceScore >= 0 && data.confidenceScore <= 100)) &&
        data.createdAt == request.time;
    }

    function isValidHoroscopeFeedback(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'date', 'rating', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.date is string && data.date.size() == 10 &&
        data.rating is number && data.rating >= 1 && data.rating <= 4 &&
        (!('accuracyVerdict' in data) || (data.accuracyVerdict is string && data.accuracyVerdict.size() <= 50)) &&
        (!('comment' in data) || (data.comment is string && data.comment.size() <= 500)) &&
        data.createdAt == request.time;
    }

    function isValidHoroscopeSubscription(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'email', 'preferredTime', 'channels', 'active', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.email is string && data.email.size() <= 150 &&
        data.preferredTime is string && data.preferredTime.size() <= 10 &&
        data.channels is list && data.channels.size() <= 5 &&
        data.active is bool &&
        (!('consentGiven' in data) || data.consentGiven is bool) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
        data.createdAt == request.time;
    }

    function isValidAiSummary(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'nativeName', 'summaryData', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.nativeName is string && data.nativeName.size() <= 100 &&
        (!('lagnaSign' in data) || (data.lagnaSign is string && data.lagnaSign.size() <= 50)) &&
        data.summaryData is map &&
        data.createdAt == request.time;
    }

    function isValidWishlistItem(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'productId', 'productSlug', 'name', 'price', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.productId is number &&
        data.productSlug is string && data.productSlug.size() <= 150 &&
        data.name is string && data.name.size() <= 200 &&
        data.price is number && data.price >= 0 &&
        (!('salePrice' in data) || (data.salePrice is number && data.salePrice >= 0)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500)) &&
        (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100)) &&
        (!('inStock' in data) || data.inStock is bool) &&
        data.createdAt == request.time;
    }

    function isValidUserOrder(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'orderNumber', 'totalAmount', 'orderStatus', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.orderNumber is string && data.orderNumber.size() <= 64 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.orderStatus is string && data.orderStatus.size() <= 50 &&
        (!('itemCount' in data) || (data.itemCount is number && data.itemCount >= 0)) &&
        (!('items' in data) || (data.items is list && data.items.size() <= 50)) &&
        data.createdAt == request.time;
    }

    // Match Finder 24-hour collection
    match /matchSubmissions/{matchId} {
      // Creation: strict validation, immutable calculation, exact 24h expiration ceiling
      allow create: if isValidId(matchId) && 
        matchId == incoming().id &&
        isValidMatchSubmission(incoming());

      // Single-document read: Allowed only if within 24-hour validity window
      allow get: if isValidId(matchId) && 
        existing().expiresAt > request.time;

      // Collection list: Must enforce that returned records are active (not expired)
      allow list: if resource.data.expiresAt > request.time;

      // Updates: Prohibited to ensure audit integrity of the calculation
      allow update: if false;

      // Deletion: Permitted once record has expired or by owner/session
      allow delete: if isValidId(matchId) && (
        existing().expiresAt <= request.time ||
        (request.auth != null && request.auth.uid == existing().sessionId)
      );
    }

    // User Profile and Account Management
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false; // Users cannot be enumerated
      allow create, update: if request.auth != null && request.auth.uid == userId && isValidUser(incoming());
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Saved AI Summaries subcollection
      match /aiSummaries/{summaryId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && isValidId(summaryId) && summaryId == incoming().id && isValidAiSummary(incoming(), userId);
        allow update: if false; // AI Summaries are immutable records
        allow delete: if request.auth != null && request.auth.uid == userId && isValidId(summaryId);
      }

      // Daily Horoscope Archive subcollection
      match /dailyHoroscopes/{date} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId && date.size() == 10 && date == incoming().id && isValidDailyHoroscope(incoming(), userId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // User Accuracy Feedback subcollection
      match /horoscopeFeedback/{feedbackId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && isValidId(feedbackId) && feedbackId == incoming().id && isValidHoroscopeFeedback(incoming(), userId);
        allow update: if false; // Feedback records are immutable
        allow delete: if request.auth != null && request.auth.uid == userId && isValidId(feedbackId);
      }

      // Horoscope Delivery Subscriptions subcollection
      match /horoscopeSubscriptions/{subId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId && isValidId(subId) && subId == incoming().id && isValidHoroscopeSubscription(incoming(), userId);
        allow delete: if request.auth != null && request.auth.uid == userId && isValidId(subId);
      }

      // Wishlist subcollection
      match /wishlist/{itemId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && isValidId(itemId) && itemId == incoming().id && isValidWishlistItem(incoming(), userId);
        allow update: if false; // Wishlist items are toggled add/remove
        allow delete: if request.auth != null && request.auth.uid == userId && isValidId(itemId);
      }

      // Orders subcollection
      match /orders/{orderId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && isValidId(orderId) && orderId == incoming().id && isValidUserOrder(incoming(), userId);
        allow update: if false; // Orders are immutable once placed
        allow delete: if false; // Orders are permanently retained for accounting and delivery tracking
      }
    }
  }
}
